        : "M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"; // menu
}

// Base of everything the remote can land on. The page owns the focus order:
// it sets `want-focus` on one control at a time, and gets the arrow keys
// (and Back) the control doesn't use through `nav` (true: the page moved
// the focus). Return or Space (the D-pad centre) press it; `key` sees the
// keys first, for value controls (left / right). `entered` runs whenever it
// gains the focus, Tab included, so the page can keep its index in step.
// Taps and clicks don't take the focus: the glow only shows for the remote
// and the keyboard.
export component Focusable inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> want-focus;
    out property <bool> focused: fs.has-focus;
    out property <bool> pressed: touch.pressed;
    out property <bool> hovered: touch.has-hover;
    // Room kept around the control when it scrolls into view.
    in property <length> reveal: 20px;
    callback clicked();
    callback nav(string) -> bool;
    callback key(string) -> bool;
    callback entered();

    init => {
        if (self.want-focus) {
            fs.focus();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            fs.focus();
        }
    }

    reveal-area := Rectangle {
        x: -root.reveal;
        y: -root.reveal;
        width: root.width + 2 * root.reveal;
        height: root.height + 2 * root.reveal;
    }

    fs := FocusScope {
        width: 0px;
        height: 0px;
        focus-gained => {
            reveal-area.ensure-visible(ScrollBehavior.smooth);
            root.entered();
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (root.enabled) {
                    root.clicked();
                }
                return accept;
            }
            if (root.key(event.text)) {
                return accept;
            }
            if (root.nav(event.text)) {
                if (event.text == Key.Back) {
                    Nav.back-taken = true;
                }
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Nav.keyboard = false;
            root.clicked();
        }
    }
}

// kind: 0 tonal, 1 primary (ember), 2 danger, 3 quiet (no fill until
// hovered or focused).
export component ActionButton inherits Focusable {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;
    property <color> fg: !root.enabled
        ? (root.kind == 1 ? Theme.accent.transparentize(0.4) : (root.kind == 2 ? Theme.danger.transparentize(0.5) : Theme.faint))
        : (root.kind == 1 ? Theme.on-accent : (root.kind == 2 ? Theme.danger : Theme.text));
    property <bool> lit: root.hovered || root.focused;

    accessible-role: button;
    accessible-label: root.text;
    height: Theme.control-height;
    min-width: content.preferred-width;
    preferred-width: content.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: !root.enabled
        ? (root.kind == 1 ? Theme.accent.transparentize(0.82) : (root.kind == 2 ? Theme.danger.transparentize(0.94) : (root.kind == 3 ? Theme.card.transparentize(1) : Theme.card.transparentize(0.45))))
        : root.kind == 1
            ? (root.pressed ? Theme.accent-pressed : (root.lit ? Theme.accent-hover : Theme.accent))
            : root.kind == 2
                ? (root.pressed || root.lit ? Theme.danger.transparentize(0.74) : Theme.danger.transparentize(0.88))
                : root.kind == 3
                    ? (root.pressed ? Theme.card-hover : (root.lit ? Theme.card : Theme.card.transparentize(1)))
                    : (root.pressed ? Theme.border : (root.lit ? Theme.card-hover : Theme.card));
    border-width: root.focused ? 2px : (root.kind == 0 || root.kind == 2 ? 1px : 0px);
    border-color: root.focused
        ? (root.kind == 1 ? Theme.text : Theme.accent)
        : (root.kind == 2 ? Theme.danger.transparentize(root.enabled ? 0.6 : 0.8) : Theme.border.transparentize(root.enabled ? 0 : 0.5));
    drop-shadow-blur: 18px;
    drop-shadow-color: root.focused ? Theme.glow : transparent;
    transform-scale: root.pressed && root.enabled ? 0.96 : 1;
    animate background, border-color { duration: 120ms; }
    animate transform-scale { duration: 110ms; easing: ease-out-quad; }

    content := HorizontalLayout {
        padding-left: root.icon != "" && root.text != "" ? 14px : 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 20px;
                height: 20px;
                name: root.icon;
                tint: root.fg;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.body-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Round icon-only button.
export component IconButton inherits Focusable {
    in property <string> icon;
    in property <string> label;
    // 1: ember fill; 3: quiet.
    in property <int> kind: 3;
    in property <color> tint: root.kind == 1 ? Theme.on-accent : Theme.text;
    property <bool> lit: root.hovered || root.focused;

    accessible-role: button;
    accessible-label: root.label;
    width: Theme.control-height;
    height: Theme.control-height;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.kind == 1
        ? (root.pressed ? Theme.accent-pressed : (root.lit ? Theme.accent-hover : Theme.accent.transparentize(root.enabled ? 0 : 0.8)))
        : (root.pressed ? Theme.border : (root.lit ? Theme.card-hover : Theme.card.transparentize(1)));
    border-width: root.focused ? 2px : 0px;
    border-color: root.kind == 1 ? Theme.text : Theme.accent;
    drop-shadow-blur: 18px;
    drop-shadow-color: root.focused ? Theme.glow : transparent;
    transform-scale: root.pressed && root.enabled ? 0.9 : 1;
    animate background { duration: 120ms; }
    animate transform-scale { duration: 110ms; easing: ease-out-quad; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        tint: root.enabled ? root.tint : Theme.faint;
    }
}

// Small status pill; `dot` puts a coloured dot in front of the text.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    in property <bool> dot: false;
    height: Theme.compact ? 26px : 24px;
    min-width: chip-row.preferred-width;
    preferred-width: chip-row.preferred-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.tone.transparentize(0.86);

    chip-row := HorizontalLayout {
        padding-left: root.dot ? 8px : 10px;
        padding-right: 10px;
        spacing: 6px;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone;
            }
        }
        Text {
            text: root.text;
            color: root.tone;
            font-size: Theme.caption-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Three embers pulsing: work in progress. A timer steps the pulse 18 times
// a second: `animation-tick()` would redraw the window at the display's full
// rate (120 Hz on many phones) for as long as it shows, and a pairing
// dialog can wait for minutes.
export component Loader inherits Rectangle {
    in property <length> dot: 8px;
    in property <color> tint: Theme.accent;
    property <length> step: root.dot * 1.8;
    property <int> tick;
    property <float> phase: root.tick / 20;
    Timer {
        interval: 55ms;
        running: true;
        triggered => {
            root.tick = Math.mod(root.tick + 1, 20);
        }
    }
    width: root.dot + 2 * root.step;
    height: root.dot;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    for ember[i] in 3: Rectangle {
        x: i * root.step;
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: root.tint;
        opacity: 0.25 + 0.75 * Math.max(0, Math.sin((root.phase - i * 0.18) * 360deg));
    }
}

// On/off pill (drawn inside a row, which takes the input).
export component Toggle inherits Rectangle {
    in property <bool> on;
    width: 48px;
    height: 28px;
    horizontal-stretch: 0;
    border-radius: 14px;
    background: root.on ? Theme.accent : Theme.bg;
    border-width: root.on ? 0px : 1.5px;
    border-color: Theme.faint;
    animate background { duration: 140ms; }

    Rectangle {
        y: (parent.height - self.height) / 2;
        x: root.on ? parent.width - self.width - 4px : 5px;
        width: root.on ? 20px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.on ? Theme.on-accent : Theme.muted;
        animate x, width { duration: 180ms; easing: ease-out; }
    }
}

// One line of text to type. It takes the focus like any control; Return
// (or a tap) starts typing. While typing, up / down leave the box, so a TV
// remote never gets stuck in it. `auto-edit` starts typing as soon as the
// page focuses it (dialogs).
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    in property <bool> multiline: false;
    in property <bool> want-focus;
    in property <bool> auto-edit: false;
    out property <bool> editing: input.has-focus;
    out property <bool> focused: fs.has-focus || input.has-focus;
    callback accepted(string);
    callback nav(string) -> bool;
    callback entered();

    function grab() {
        if (root.auto-edit && root.enabled) {
            input.focus();
        } else {
            fs.focus();
        }
    }
    public function edit() {
        if (root.enabled) {
            input.focus();
        }
    }

    init => {
        if (self.want-focus) {
            root.grab();
        }
    }
    changed want-focus => {
        if (self.want-focus) {
            root.grab();
        }
    }

    accessible-role: text-input;
    min-height: root.multiline ? 104px : Theme.control-height;
    preferred-height: root.multiline ? 104px : Theme.control-height;
    border-radius: Theme.radius-sm;
    background: root.enabled ? Theme.bg : Theme.bg.transparentize(0.5);
    border-width: root.focused ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : (fs.has-focus ? Theme.accent : (area.has-hover ? Theme.faint : Theme.border.transparentize(root.enabled ? 0 : 0.5)));
    drop-shadow-blur: 18px;
    drop-shadow-color: fs.has-focus ? Theme.glow : transparent;
    animate border-color { duration: 120ms; }

    fs := FocusScope {
        width: 0px;
        height: 0px;
        focus-gained => {
            root.ensure-visible(ScrollBehavior.smooth);
            root.entered();
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.edit();
                return accept;
            }
            if (root.nav(event.text)) {
                if (event.text == Key.Back) {
                    Nav.back-taken = true;
                }
                return accept;
            }
            return reject;
        }
    }

    area := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            Nav.keyboard = false;
            root.edit();
        }
    }

    // While typing: up / down move on to the next control.
    cap := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        x: 14px;
        y: root.multiline ? 10px : 0px;
        width: parent.width - 28px;
        height: parent.height - (root.multiline ? 20px : 0px);
        capture-key-pressed(event) => {
            if (input.has-focus && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                if (root.nav(event.text)) {
                    return accept;
                }
            }
            return reject;
        }
        if root.text == "": Text {
            width: parent.width;
            height: parent.height;
            text: root.placeholder;
            color: Theme.faint;
            font-size: Theme.body-size;
            vertical-alignment: root.multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
            overflow: elide;
        }
        input := TextInput {
            width: parent.width;
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            input-type: root.input-type;
            single-line: !root.multiline;
            wrap: root.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
            color: root.enabled ? Theme.text : Theme.faint;
            font-size: Theme.body-size;
            vertical-alignment: root.multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
            selection-background-color: Theme.accent.transparentize(0.55);
            selection-foreground-color: Theme.text;
            accepted => {
                root.accepted(self.text);
            }
        }
    }

    changed editing => {
        if (root.editing) {
            root.entered();
        }
    }
}

// Modal card over a scrim: centred on wide screens, a sheet on phones.
// It rises and grows into place while the scrim darkens and the contents
// fade in; tapping the scrim calls `dismissed`. The card's shadow sits on an
// element that never moves inside the animated `slot`, so its texture is
// rendered once, not on every frame of the motion.
export component Modal inherits Rectangle {
    in property <length> card-width: 440px;
    // Keep the focus on the dialog itself (nothing glows) until an arrow
    // key, which calls `arrow` to focus a control.
    in property <bool> hold-focus: false;
    callback arrow();
    // Back or Escape while it holds the focus: true when handled (dialogs
    // inside a page close themselves; the window handles its own).
    callback back() -> bool;
    callback dismissed;
    property <bool> shown;
    property <bool> sheet: Theme.compact;

    background: root.shown ? Theme.scrim : Theme.scrim.transparentize(1);
    animate background { duration: 200ms; easing: ease-out-quad; }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }

    if root.hold-focus: FocusScope {
        width: 0px;
        height: 0px;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.arrow();
                return accept;
            }
            if ((event.text == Key.Back || event.text == Key.Escape) && root.back()) {
                if (event.text == Key.Back) {
                    Nav.back-taken = true;
                }
                return accept;
            }
            return reject;
        }
    }

    slot := Rectangle {
        width: root.sheet ? root.width : Math.min(root.card-width, root.width - 48px);
        height: Math.min(content.preferred-height, root.height - (root.sheet ? 24px : 48px));
        x: (root.width - self.width) / 2;
        y: root.sheet
            ? root.height - self.height + (root.shown ? 0px : Math.min(self.height, 120px))
            : (root.height - self.height) / 2 + (root.shown ? 0px : 18px);
        transform-scale: root.shown || root.sheet ? 1 : 0.94;
        animate y { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        animate transform-scale { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }

        card := Rectangle {
            border-radius: Theme.radius + 4px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #000000a0;
            clip: true;

            // Swallow taps so they don't reach the scrim.
            TouchArea { }

            content := VerticalLayout {
                padding: Theme.compact ? 20px : 26px;
                padding-bottom: Theme.compact ? 28px : 26px;
                spacing: 14px;
                @children
            }

            // The contents fade in under a veil of the card's own colour: a
            // plain rectangle, where `opacity` on the card would render it
            // through an offscreen layer.
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: Theme.radius + 3px;
                background: Theme.surface;
                opacity: root.shown ? 0 : 1;
                visible: self.opacity > 0;
                animate opacity { duration: 220ms; delay: 40ms; easing: ease-out-quad; }
            }
        }
    }
}

// A page. It slides a little in from the side it comes from (`enter-dir`:
// 1 forward, from the right; -1 back, from the left; 0 in place) under a
// veil of the background that lifts. Moving a page costs nothing but the
// redraw, and the veil is a single rectangle, where fading the whole page
// with `opacity` would render it through a full-screen offscreen layer on
// every frame of the fade.
//
// Arriving with the remote or a keyboard, the page focuses its first
// control (`focus-first`). That happens here, after the page is built: a
// change made in an `init` doesn't reach the change handlers of controls
// built before it, so they would never take the focus.
export component Page inherits Rectangle {
    in property <int> enter-dir;
    callback focus-first();
    property <int> dir;
    property <bool> arrived;

    init => {
        root.dir = root.enter-dir;
    }
    // A frame or two after creation, so the first frame draws the start.
    Timer {
        interval: 30ms;
        running: !root.arrived;
        triggered => {
            root.arrived = true;
            if (Nav.keyboard) {
                root.focus-first();
            }
        }
    }
    x: root.arrived ? 0px : root.dir * (Theme.compact ? 28px : 48px);
    animate x { duration: 340ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    Rectangle {
        // Above everything the page adds, overlays included.
        z: 1000;
        background: Theme.bg;
        opacity: root.arrived ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: 240ms; easing: ease-out-quad; }
    }
}

// The title line of a dialog.
export component DialogTitle inherits Text {
    color: Theme.text;
    font-size: Theme.title-size;
    font-weight: 700;
    wrap: word-wrap;
}

// Body copy of a dialog.
export component DialogText inherits Text {
    color: Theme.muted;
    font-size: Theme.body-size;
    wrap: word-wrap;
}
