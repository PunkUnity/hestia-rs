// Hestia's visual language, "hearth": warm soot surfaces, a single ember
// accent and focus that glows like an ember, so a TV remote, a keyboard or
// a game controller always shows where it is. Every control here works with
// touch, the mouse and the arrow keys / D-pad alike.
//
// Motion and effects stay cheap on TV boxes and phones alike. The rules,
// from how Slint's renderers (Skia on Android, FemtoVG on the desktop)
// draw:
// * A drop shadow is a texture, one per element whose shadow colour isn't
//   transparent, even when it hides behind the element. Only the focused
//   control has a shadow colour.
// * That texture is drawn again whenever the shadow's blur, colour or size,
//   or the element's position, background or border, changes. So a blur
//   never animates, and something that moves while it casts a shadow moves
//   a parent (`slot`), never the shadowed element itself.
// * `opacity` below 1 on an element with children draws it through an
//   offscreen layer, every frame. Fades use a veil (a plain rectangle in
//   the colour underneath) or a childless element; disabled controls dim
//   their colours.
// * Translation and `transform-scale` are free: they need no layout and no
//   new textures. Motion here is made of them.
// * Over the stream, everything redraws with every picture: overlays there
//   only move, without shadows or fades.
// * Nothing animates continuously; `Loader` steps on a slow timer.
// * Android's "Remove animations" turns every `animate` off (Slint reads
//   it); timers then only flip states.

import "../fonts/Outfit-Regular.ttf";
import "../fonts/Outfit-Medium.ttf";
import "../fonts/Outfit-SemiBold.ttf";
import "../fonts/Outfit-Bold.ttf";

// Back pressed and handled somewhere: the window keeps its release too
// (Android would otherwise act on the release and close the app).
export global Nav {
    in-out property <bool> back-taken;
    // The last interaction was a key (remote, keyboard, controller) rather
    // than a tap or a click: dialogs and pages then put the focus somewhere
    // right away, and stay without a focus glow for touch.
    in-out property <bool> keyboard;
}

struct ThemePalette {
    bg: color,
    surface: color,
    card: color,
    card-hover: color,
    border: color,
    text: color,
    muted: color,
    faint: color,
    accent: color,
    accent-hover: color,
    accent-pressed: color,
    on-accent: color,
    glow: color,
    ok: color,
    warn: color,
    danger: color,
    info: color,
    scrim: color,
}

export global Theme {
    in-out property <int> selection;
    // Color roles belong to the palette. Font and control metrics are separate.
    property <ThemePalette> palette: root.selection == 2 ? root.midnight : root.selection == 1 ? root.daylight : root.hearth;
    property <ThemePalette> hearth: {
        bg: #110e0c,
        surface: #1a1613,
        card: #231e1a,
        card-hover: #2e2823,
        border: #3b332c,
        text: #f5eee8,
        muted: #ab9f95,
        faint: #71675f,
        accent: #ff7a2e,
        accent-hover: #ff9a57,
        accent-pressed: #e3631d,
        on-accent: #1f0c02,
        glow: #ff7a2e80,
        ok: #67d491,
        warn: #f5b43f,
        danger: #ff6868,
        info: #9ec5ea,
        scrim: #0a0807c8,
    };
    property <ThemePalette> daylight: {
        bg: #edf2f9,
        surface: #f8fafd,
        card: #ffffff,
        card-hover: #e5ebf9,
        border: #bdc9df,
        text: #172238,
        muted: #44536d,
        faint: #586984,
        accent: #3b4e9d,
        accent-hover: #4359af,
        accent-pressed: #2c3b7d,
        on-accent: #ffffff,
        glow: #415ab74d,
        ok: #176848,
        warn: #795000,
        danger: #aa2642,
        info: #254d93,
        scrim: #172238a8,
    };
    property <ThemePalette> midnight: {
        bg: #141620,
        surface: #1c1e29,
        card: #252736,
        card-hover: #303344,
        border: #4b4d63,
        text: #f0edf7,
        muted: #c5bfd5,
        faint: #aba5bf,
        accent: #c1a2ff,
        accent-hover: #d2baff,
        accent-pressed: #ae8be9,
        on-accent: #21143b,
        glow: #ac82ff66,
        ok: #83d8a8,
        warn: #f1bb79,
        danger: #ff9eb5,
        info: #9ec6fa,
        scrim: #0b0c16c9,
    };

    out property <color> bg: root.palette.bg;
    out property <color> surface: root.palette.surface;
    out property <color> card: root.palette.card;
    out property <color> card-hover: root.palette.card-hover;
    out property <color> border: root.palette.border;
    out property <color> text: root.palette.text;
    out property <color> muted: root.palette.muted;
    out property <color> faint: root.palette.faint;
    out property <color> accent: root.palette.accent;
    out property <color> accent-hover: root.palette.accent-hover;
    out property <color> accent-pressed: root.palette.accent-pressed;
    out property <color> on-accent: root.palette.on-accent;
    out property <color> glow: root.palette.glow;
    out property <color> ok: root.palette.ok;
    out property <color> warn: root.palette.warn;
    out property <color> danger: root.palette.danger;
    out property <color> info: root.palette.info;
    out property <color> scrim: root.palette.scrim;
    out property <string> font: "Outfit";

    // The window's size (set by the window). Phones in portrait are
    // compact; desktops are wide; landscape phones and TVs (960 × 540 dp)
    // are short.
    in-out property <length> window-width: 1180px;
    in-out property <length> window-height: 760px;
    out property <bool> compact: root.window-width < 600px;
    out property <bool> wide: root.window-width >= 1024px;
    out property <bool> short: root.window-height < 600px;

    // Spacing
    out property <length> page-padding: root.compact ? 16px : (root.wide ? 40px : 28px);
    out property <length> gap: root.compact ? 12px : 18px;
    // Touch targets: 48px on phones.
    out property <length> control-height: root.compact ? 48px : 44px;
    out property <length> radius: 18px;
    out property <length> radius-sm: 12px;

    // Type scale (Outfit)
    out property <length> display-size: root.compact || root.short ? 26px : 32px;
    out property <length> title-size: root.compact ? 19px : 21px;
    out property <length> heading-size: root.compact ? 16px : 15px;
    out property <length> body-size: root.compact ? 15px : 14px;
    out property <length> caption-size: root.compact ? 13px : 12px;
}

