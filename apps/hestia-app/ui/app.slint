import { Theme, Nav, Icon, ActionButton, Loader, TextField, Modal, DialogTitle, DialogText } from "theme.slint";
import { HostCard, AppCard, CommandRow, PreflightRow, HostsPage, AppsPage, SessionPage, SettingsPage, ToolsPage, ReportPage } from "pages.slint";
import { DiagnosticsOverlayPage, OverlayOption } from "pages.slint";
import { StreamView, PadControl } from "stream.slint";

export { HostCard, AppCard, CommandRow, PreflightRow } from "pages.slint";
export { PadControl } from "stream.slint";
export { OverlayOption } from "pages.slint";

export component AppWindow inherits Window {
    title: "Hestia";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 340px;
    min-height: 400px;
    // Direct video: the picture is on a surface behind the window, so the
    // window is clear wherever the UI draws nothing.
    background: root.stream-direct-video && root.screen == 4 ? transparent : root.stream-picture-in-picture ? black : Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.body-size;
    forward-focus: keys;

    // Phones, TVs and desktop windows: the layout follows the window size.
    init => {
        Theme.window-width = self.width;
        Theme.window-height = self.height;
    }
    changed width => {
        Theme.window-width = self.width;
    }
    changed height => {
        Theme.window-height = self.height;
    }

    // 0 = hosts, 1 = apps, 2 = session (launching / errors), 3 = settings, 4 = stream, 5 = host tools,
    // 6 = stream report, 7 = diagnostics overlay settings
    in-out property <int> screen: 0;

    // Startup (identity generation on first run)
    in property <bool> starting: true;
    in property <string> starting-text: "Getting ready…";

    in property <string> toast;

    // Hosts
    in property <[HostCard]> hosts;
    in property <bool> scanning;
    callback refresh-hosts();
    callback open-host(string);

    // Add host
    in-out property <bool> add-visible;
    in property <string> add-error;
    in property <bool> add-busy;
    in-out property <string> add-address;
    callback add-host(string);

    // Pairing
    in-out property <bool> pair-visible;
    in property <string> pair-host-name;
    in property <string> pair-pin;
    in property <string> pair-status;
    in property <bool> pair-busy;
    in property <bool> pair-failed;
    in-out property <bool> pair-otp-mode;
    in-out property <string> otp-pin;
    in-out property <string> otp-passphrase;
    callback pair-retry();
    callback pair-use-otp();
    callback pair-submit-otp(string, string);
    callback pair-cancel();

    // Apps
    in property <string> host-name;
    in-out property <bool> host-edit-visible;
    in-out property <string> host-edit-name;
    in-out property <string> host-edit-address;
    in property <string> host-edit-error;
    callback open-host-editor();
    callback save-host-edit(string, string);
    in property <string> host-detail;
    in property <[string]> host-chips;
    in property <[AppCard]> apps;
    in property <bool> apps-loading;
    in property <bool> app-running;
    in property <bool> host-hermes;
    callback launch-app(int);
    callback quit-app();
    callback forget-host();
    callback back-to-hosts();

    // Session
    in property <string> session-title;
    in property <string> session-subtitle;
    in property <[string]> session-lines;
    in property <bool> session-busy;
    callback back-to-apps();

    // Stream report
    in property <string> report-title;
    in property <[string]> report-summary;
    in property <string> report-path;
    in property <[string]> report-log-tail;
    in property <string> report-export-label: "Share";
    in property <bool> report-can-send;
    in property <bool> report-busy;
    callback report-export();
    callback report-send-to-host();
    callback open-last-report();
    callback open-app-log();

    // Host tools (Hermes)
    in property <bool> tools-loading;
    in property <bool> tools-busy;
    in property <string> tools-message;
    in property <string> tools-display-status;
    in property <bool> tools-display-allowed: true;
    in property <[CommandRow]> tools-commands;
    in property <bool> tools-commands-allowed: true;
    in property <bool> tools-clipboard-allowed: true;
    in-out property <string> tools-clipboard-text;
    in property <string> tools-permissions;
    in property <[string]> tools-diagnostics;
    in property <[string]> tools-status-lines;
    in property <[PreflightRow]> tools-preflight;
    callback open-tools();
    callback tools-open-web-ui();
    callback tools-host-report();
    callback tools-refresh();
    callback tools-recover-display();
    callback tools-run-command(int);
    callback tools-send-clipboard(string);
    callback tools-fetch-clipboard();

    // Stream
    in property <image> stream-frame;
    in property <bool> stream-picture-in-picture: false;
    in property <bool> stream-direct-video: false;
    property <float> stream-picture-aspect: root.stream-frame.height > 0
        ? 1.0 * root.stream-frame.width / root.stream-frame.height : 0;
    callback stream-pip-config(bool, float);
    changed screen => {
        if root.is-android {
            root.stream-pip-config(root.screen == 4, root.stream-picture-aspect);
        }
    }
    changed stream-picture-aspect => {
        if root.is-android && root.screen == 4 && root.stream-picture-aspect > 0 {
            root.stream-pip-config(true, root.stream-picture-aspect);
        }
    }
    in property <string> stream-stats;
    in property <string> stream-status;
    in-out property <bool> stream-show-stats: true;
    in property <bool> stream-fullscreen;
    in property <int> stream-touch-mode: 0;
    in-out property <bool> stream-menu-open: false;
    in property <bool> stream-pad-visible: false;
    in property <bool> stream-clipboard: false;
    callback stream-clipboard-send();
    callback stream-clipboard-fetch();
    in property <[PadControl]> stream-pad-controls;
    in property <bool> stream-zoom-mode: false;
    in property <float> stream-zoom: 1;
    in property <float> stream-pan-x: 0;
    in property <float> stream-pan-y: 0;
    callback stream-toggle-pad();
    callback stream-toggle-zoom();
    callback stream-view-size(float, float);
    in-out property <bool> stream-keyboard-open: false;
    in property <string> stream-banner;
    callback stream-key(string, bool, bool, bool, bool, bool, bool);
    callback stream-pointer(int, int, float, float, float, float, int, float, float);
    callback stream-scroll(float, float);
    // The on-screen keyboard was opened or closed in the stream.
    callback stream-keyboard(bool);
    in-out property <bool> stream-show-menu-button: true;
    in property <bool> stream-soft-keyboard: false;
    callback stream-special-key(string);
    callback stream-cycle-touch-mode();
    callback stream-request-keyframe();
    in-out property <int> stream-video-scale: 0;
    callback stream-cycle-scale();
    callback stream-toggle-fullscreen();
    callback stream-disconnect();
    callback stream-quit();
    in property <bool> stream-pointer-capture-available: false;
    in property <bool> stream-mouse-capture: false;
    callback stream-toggle-mouse-capture();
    // The stream view has the keyboard and mouse (window focused, menu closed).
    callback stream-input-focus(bool);

    // Settings
    in-out property <[string]> cfg-resolution-options: ["1280 × 720", "1920 × 1080", "2560 × 1440", "3840 × 2160"];
    in-out property <[string]> cfg-fps-options: ["30 fps", "60 fps", "90 fps", "120 fps", "144 fps"];
    in-out property <int> cfg-preset: 0;
    in-out property <string> cfg-preset-hint;
    in-out property <int> cfg-video-scale: 0;
    callback settings-preset-changed(int);
    in-out property <int> cfg-resolution: 1;
    in-out property <int> cfg-fps: 1;
    in-out property <float> cfg-bitrate: 20;
    in-out property <float> cfg-metered-bitrate: 0;
    in property <[string]> cfg-codec-options;
    in-out property <int> cfg-codec: 0;
    in-out property <int> cfg-audio: 0;
    in-out property <bool> cfg-hdr;
    in-out property <bool> cfg-virtual-display: true;
    in-out property <bool> cfg-host-audio;
    in-out property <bool> cfg-gamescope;
    in-out property <bool> cfg-optimize: true;
    in-out property <bool> cfg-clipboard;
    in-out property <bool> cfg-show-report: true;
    in-out property <bool> cfg-show-menu-button: false;
    in-out property <bool> cfg-hardware-decoding: true;
    in-out property <bool> cfg-gpu-video: true;
    in-out property <bool> cfg-direct-video: true;
    in property <[string]> cfg-profile-names;
    in-out property <int> cfg-profile-pick;
    callback settings-save-profile(string);
    callback settings-load-profile(int);
    callback settings-delete-profile(int);
    in property <[string]> apps-profile-options;
    in-out property <int> apps-profile-index;
    callback apps-profile-chosen(int);
    in property <bool> is-android: false;
    // Android reports touchscreen support. Desktop input enables this on first touch.
    in property <bool> has-touch-input;
    in-out property <int> cfg-orientation: 0;
    callback settings-custom-resolution(string);
    in property <string> client-id;
    in property <string> cfg-host-name;
    in property <bool> cfg-physical-keyboard;
    in-out property <string> cfg-shortcut-disconnect: "Ctrl+Alt+Shift+Q";
    in-out property <string> cfg-shortcut-stats: "Ctrl+Alt+Shift+S";
    in-out property <string> cfg-shortcut-capture: "Ctrl+Alt+Shift+Z";
    callback settings-update-shortcut(int, string);
    in property <string> data-dir;
    in property <string> version-text;
    property <int> settings-return: 0;
    callback open-settings();
    callback save-settings();
    property <bool> returning-from-overlay;
    property <length> settings-scroll-y;
    property <[OverlayOption]> overlay-draft;
    in-out property <bool> overlay-saving;
    in-out property <bool> overlay-save-failed;
    callback load-overlay-options() -> [OverlayOption];
    callback save-overlay-options([OverlayOption]);

    // Escape (and the Android back key) closes dialogs and walks back
    // through the screens.
    function go-back() -> bool {
        if (root.pair-visible) {
            root.pair-cancel();
            return true;
        }
        if (root.host-edit-visible) {
            root.host-edit-visible = false;
            return true;
        }
        if (root.add-visible) {
            if (!root.add-busy) {
                root.add-visible = false;
            }
            return true;
        }
        if (root.screen == 4) {
            // Never leave the stream by accident; the menu has Disconnect.
            root.stream-keyboard-open = false;
            return true;
        }
        if (root.screen == 3) {
            root.screen = root.settings-return;
            return true;
        }
        if (root.screen == 7) {
            if (!root.overlay-saving) {
                root.screen = 3;
            }
            return true;
        }
        if (root.screen == 5 || root.screen == 6) {
            root.screen = 1;
            return true;
        }
        if (root.screen == 2) {
            root.back-to-apps();
            return true;
        }
        if (root.screen == 1) {
            root.back-to-hosts();
            return true;
        }
        return false;
    }

    changed stream-keyboard-open => {
        root.stream-keyboard(root.stream-keyboard-open);
    }

    // Page transitions: a page slides in from the right going deeper and
    // from the left coming back. `page-depth` is the depth of the page shown
    // last: each page reads it as it's created, then its `init` below sets
    // it. Hosts 0; apps and settings 1; launching, tools and the report 2;
    // the stream 3, which pages after it don't slide away from.
    property <int> page-depth: 0;
    pure function slide-dir(depth: int) -> int {
        return root.page-depth >= 3 ? 0 : (depth > root.page-depth ? 1 : (depth < root.page-depth ? -1 : 0));
    }

    // Pages hold the focus themselves (remote navigation) and take it on
    // creation; after a dialog closes they get it back.
    property <int> nav-refocus;
    function take-focus() {
        if (root.screen != 4) {
            root.nav-refocus += 1;
        }
    }
    // The focused control of the open dialog.
    // -1: none yet (touch); the dialog holds the focus until an arrow key.
    property <int> dlg: -1;
    // Where a dialog's focus starts: typing right away on the desktop, the
    // first control with a remote, nothing on a touch screen.
    pure function pair-start() -> int {
        return root.pair-otp-mode ? (!root.is-android || Nav.keyboard ? 0 : -1) : (Nav.keyboard ? 1 : -1);
    }
    changed add-visible => {
        if (root.add-visible) {
            root.dlg = !root.is-android || Nav.keyboard ? 0 : -1;
        } else {
            root.dlg = -1;
            root.take-focus();
        }
    }
    changed host-edit-visible => {
        if (root.host-edit-visible) {
            root.dlg = !root.is-android || Nav.keyboard ? 0 : -1;
        } else {
            root.dlg = -1;
            root.take-focus();
        }
    }
    changed pair-visible => {
        if (root.pair-visible) {
            root.dlg = root.pair-start();
        } else {
            root.dlg = -1;
            root.take-focus();
        }
    }
    changed pair-otp-mode => {
        root.dlg = root.pair-start();
    }
    changed pair-failed => {
        if (root.pair-failed && !root.pair-otp-mode && root.pair-visible && Nav.keyboard) {
            root.dlg = 2;
        }
    }

    // The pages move the focus with the arrow keys themselves, so the TV
    // remote's D-pad always arrives as arrows (no Tab conversion).
    out property <bool> form-navigation: false;
    callback form-navigation-changed(bool);
    changed form-navigation => {
        root.form-navigation-changed(self.form-navigation);
    }

    // Every screen lives inside this scope, so keys nobody else handled
    // (Escape, the Android back button) bubble up to it wherever the focus
    // is. Unhandled Back on the hosts screen lets Android close the app.
    keys := FocusScope {
        visible: !root.stream-picture-in-picture || root.screen == 4;
        // The pages keep clear of the status and navigation bars and a
        // display cutout: Android draws the window under them, and Slint
        // reports their size here (zero in full screen). The stream uses the
        // whole screen.
        property <bool> full-bleed: root.screen == 4;
        x: self.full-bleed ? 0 : root.safe-area-insets.left;
        y: self.full-bleed ? 0 : root.safe-area-insets.top;
        width: self.full-bleed ? root.width : root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: self.full-bleed ? root.height : root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        // Every key press, before anyone handles it.
        capture-key-pressed(event) => {
            Nav.keyboard = true;
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                if (root.go-back()) {
                    if (event.text == Key.Back) {
                        Nav.back-taken = true;
                    }
                    return accept;
                }
                if (event.text == Key.Back) {
                    Nav.back-taken = false;
                }
            }
            return reject;
        }
        key-released(event) => {
            // Android sends the release separately; keep it from reaching
            // the Activity once the press was handled.
            if (event.text == Key.Back && Nav.back-taken) {
                Nav.back-taken = false;
                return accept;
            }
            return reject;
        }

        if root.screen == 0: HostsPage {
            width: 100%;
            height: 100%;
            refocus: root.nav-refocus;
            enter-dir: root.slide-dir(0);
            init => {
                root.page-depth = 0;
            }
            hosts: root.hosts;
            scanning: root.scanning;
            open-host(id) => {
                root.open-host(id);
            }
            add-host => {
                root.add-visible = true;
            }
            refresh => {
                root.refresh-hosts();
            }
            settings => {
                root.settings-return = root.screen;
                root.returning-from-overlay = false;
                root.screen = 3;
                root.open-settings();
            }
        }

        if root.screen == 1: AppsPage {
            width: 100%;
            height: 100%;
            refocus: root.nav-refocus;
            enter-dir: root.slide-dir(1);
            init => {
                root.page-depth = 1;
            }
            host-name: root.host-name;
            host-detail: root.host-detail;
            chips: root.host-chips;
            apps: root.apps;
            loading: root.apps-loading;
            app-running: root.app-running;
            hermes: root.host-hermes;
            profile-options: root.apps-profile-options;
            profile-index <=> root.apps-profile-index;
            profile-chosen(index) => {
                root.apps-profile-chosen(index);
            }
            settings => {
                root.settings-return = 1;
                root.returning-from-overlay = false;
                root.screen = 3;
                root.open-settings();
            }
            edit-host => {
                root.open-host-editor();
            }
            tools => {
                root.open-tools();
            }
            back => {
                root.back-to-hosts();
            }
            launch(id) => {
                root.launch-app(id);
            }
            quit-app => {
                root.quit-app();
            }
            forget => {
                root.forget-host();
            }
        }

        if root.screen == 2: SessionPage {
            width: 100%;
            height: 100%;
            refocus: root.nav-refocus;
            enter-dir: root.slide-dir(2);
            init => {
                root.page-depth = 2;
            }
            title: root.session-title;
            subtitle: root.session-subtitle;
            lines: root.session-lines;
            busy: root.session-busy;
            back => {
                root.back-to-apps();
            }
            quit-app => {
                root.quit-app();
            }
        }

        if root.screen == 4: StreamView {
            width: 100%;
            height: 100%;
            init => {
                root.page-depth = 3;
            }
            frame: root.stream-frame;
            picture-in-picture: root.stream-picture-in-picture;
            direct-video: root.stream-direct-video;
            stats: root.stream-stats;
            status: root.stream-status;
            title: root.session-title;
            subtitle: root.host-name;
            show-stats: root.stream-show-stats;
            fullscreen: root.stream-fullscreen;
            touch-mode: root.stream-touch-mode;
            menu-open <=> root.stream-menu-open;
            touch-controls: root.has-touch-input;
            window-fullscreen: !root.is-android;
            pad-visible: root.has-touch-input && root.stream-pad-visible;
            clipboard-actions: root.stream-clipboard;
            clipboard-send => {
                root.stream-clipboard-send();
            }
            clipboard-fetch => {
                root.stream-clipboard-fetch();
            }
            pad-controls: root.stream-pad-controls;
            zoom-mode: root.stream-zoom-mode;
            zoom: root.stream-zoom;
            pan-x: root.stream-pan-x;
            pan-y: root.stream-pan-y;
            toggle-pad => {
                root.stream-toggle-pad();
            }
            toggle-zoom => {
                root.stream-toggle-zoom();
            }
            view-size(w, h) => {
                root.stream-view-size(w, h);
            }
            video-scale: root.stream-video-scale;
            keyboard-open <=> root.stream-keyboard-open;
            show-menu-button: root.stream-show-menu-button;
            soft-keyboard: root.stream-soft-keyboard;
            banner: root.stream-banner;
            key-event(text, pressed, repeat, ctrl, alt, shift, meta) => {
                root.stream-key(text, pressed, repeat, ctrl, alt, shift, meta);
            }
            pointer(kind, button, x, y, w, h, finger, sx, sy) => {
                root.stream-pointer(kind, button, x, y, w, h, finger, sx, sy);
            }
            scrolled(dx, dy) => {
                root.stream-scroll(dx, dy);
            }
            special-key(name) => {
                root.stream-special-key(name);
            }
            cycle-touch-mode => {
                root.stream-cycle-touch-mode();
            }
            cycle-scale => {
                root.stream-cycle-scale();
            }
            request-keyframe => {
                root.stream-request-keyframe();
            }
            toggle-stats => {
                root.stream-show-stats = !root.stream-show-stats;
            }
            toggle-fullscreen => {
                root.stream-toggle-fullscreen();
            }
            disconnect => {
                root.stream-disconnect();
            }
            quit-app => {
                root.stream-quit();
            }
            mouse-capture-available: root.stream-pointer-capture-available;
            mouse-capture: root.stream-mouse-capture;
            toggle-mouse-capture => {
                root.stream-toggle-mouse-capture();
            }
            input-focus(on) => {
                root.stream-input-focus(on);
            }
        }

        if root.screen == 6: ReportPage {
            width: 100%;
            height: 100%;
            refocus: root.nav-refocus;
            enter-dir: root.slide-dir(2);
            init => {
                root.page-depth = 2;
            }
            title: root.report-title;
            summary: root.report-summary;
            path: root.report-path;
            log-tail: root.report-log-tail;
            export-label: root.report-export-label;
            can-send-to-host: root.report-can-send;
            busy: root.report-busy;
            done => {
                root.back-to-apps();
            }
            export => {
                root.report-export();
            }
            send-to-host => {
                root.report-send-to-host();
            }
        }

        if root.screen == 5: ToolsPage {
            width: 100%;
            height: 100%;
            refocus: root.nav-refocus;
            enter-dir: root.slide-dir(2);
            init => {
                root.page-depth = 2;
            }
            host-name: root.host-name;
            loading: root.tools-loading;
            busy: root.tools-busy;
            message: root.tools-message;
            display-status: root.tools-display-status;
            display-allowed: root.tools-display-allowed;
            commands: root.tools-commands;
            commands-allowed: root.tools-commands-allowed;
            clipboard-allowed: root.tools-clipboard-allowed;
            clipboard-text <=> root.tools-clipboard-text;
            permissions: root.tools-permissions;
            diagnostics: root.tools-diagnostics;
            status-lines: root.tools-status-lines;
            preflight: root.tools-preflight;
            back => {
                root.screen = 1;
            }
            open-web-ui => {
                root.tools-open-web-ui();
            }
            host-report => {
                root.tools-host-report();
            }
            refresh => {
                root.tools-refresh();
            }
            recover-display => {
                root.tools-recover-display();
            }
            run-command(id) => {
                root.tools-run-command(id);
            }
            send-clipboard(text) => {
                root.tools-send-clipboard(text);
            }
            fetch-clipboard => {
                root.tools-fetch-clipboard();
            }
        }

        if root.screen == 3: SettingsPage {
            width: 100%;
            height: 100%;
            refocus: root.nav-refocus;
            focus-overlay: root.returning-from-overlay;
            initial-scroll-y: root.returning-from-overlay ? root.settings-scroll-y : 0px;
            enter-dir: root.slide-dir(1);
            init => {
                root.page-depth = 1;
            }
            resolution-options: root.cfg-resolution-options;
            fps-options: root.cfg-fps-options;
            codec-names: root.cfg-codec-options;
            preset <=> root.cfg-preset;
            preset-hint: root.cfg-preset-hint;
            video-scale <=> root.cfg-video-scale;
            preset-changed(index) => {
                root.settings-preset-changed(index);
            }
            resolution <=> root.cfg-resolution;
            fps <=> root.cfg-fps;
            bitrate-mbps <=> root.cfg-bitrate;
            metered-bitrate-mbps <=> root.cfg-metered-bitrate;
            codec <=> root.cfg-codec;
            audio <=> root.cfg-audio;
            hdr <=> root.cfg-hdr;
            virtual-display <=> root.cfg-virtual-display;
            host-audio <=> root.cfg-host-audio;
            gamescope <=> root.cfg-gamescope;
            optimize <=> root.cfg-optimize;
            clipboard <=> root.cfg-clipboard;
            client-id: root.client-id;
            data-dir: root.data-dir;
            version: root.version-text;
            show-report <=> root.cfg-show-report;
            show-menu-button <=> root.cfg-show-menu-button;
            hardware-decoding <=> root.cfg-hardware-decoding;
            gpu-video <=> root.cfg-gpu-video;
            direct-video <=> root.cfg-direct-video;
            android: root.is-android;
            physical-keyboard: root.cfg-physical-keyboard;
            host-name: root.cfg-host-name;
            shortcut-disconnect <=> root.cfg-shortcut-disconnect;
            shortcut-stats <=> root.cfg-shortcut-stats;
            shortcut-capture <=> root.cfg-shortcut-capture;
            update-shortcut(which, value) => { root.settings-update-shortcut(which, value); }
            touch-controls: root.has-touch-input;
            orientation <=> root.cfg-orientation;
            profile-names: root.cfg-profile-names;
            profile-pick <=> root.cfg-profile-pick;
            save-profile(name) => {
                root.settings-save-profile(name);
            }
            load-profile(index) => {
                root.settings-load-profile(index);
            }
            delete-profile(index) => {
                root.settings-delete-profile(index);
            }
            custom-resolution(text) => {
                root.settings-custom-resolution(text);
            }
            open-last-report => {
                root.open-last-report();
            }
            open-app-log => {
                root.open-app-log();
            }
            open-overlay(scroll-y) => {
                root.overlay-draft = root.load-overlay-options();
                root.overlay-save-failed = false;
                root.returning-from-overlay = true;
                root.settings-scroll-y = scroll-y;
                root.screen = 7;
            }
            back => {
                root.screen = root.settings-return;
            }
            save => {
                root.save-settings();
                root.screen = root.settings-return;
            }
        }

        if root.screen == 7: DiagnosticsOverlayPage {
            width: 100%;
            height: 100%;
            enter-dir: root.slide-dir(2);
            init => {
                root.page-depth = 2;
            }
            options: root.overlay-draft;
            saving: root.overlay-saving;
            save-failed: root.overlay-save-failed;
            back => {
                root.go-back();
            }
            save => {
                root.overlay-saving = true;
                root.overlay-save-failed = false;
                root.save-overlay-options(root.overlay-draft);
            }
        }

        // ---------------------------------------------------------------
        // Edit the paired host's local alias and its preferred connection.
        // This never edits the hostname on Hermes or invalidates pairing.
        if root.host-edit-visible: Modal {
            width: 100%;
            height: 100%;
            hold-focus: root.dlg < 0;
            arrow => { root.dlg = 0; }
            dismissed => { root.host-edit-visible = false; }

            DialogTitle { text: "Edit host"; }
            DialogText { text: "Choose a local name and change the preferred IP or DNS address. The paired host identity is preserved."; }
            TextField {
                placeholder: "Host name";
                text <=> root.host-edit-name;
                auto-edit: !root.is-android;
                want-focus: root.dlg == 0;
                nav(k) => {
                    if (k == Key.DownArrow) { root.dlg = 1; return true; }
                    return false;
                }
                entered => { root.dlg = 0; }
            }
            TextField {
                placeholder: "192.168.0.10:47989";
                text <=> root.host-edit-address;
                auto-edit: !root.is-android;
                want-focus: root.dlg == 1;
                nav(k) => {
                    if (k == Key.UpArrow) { root.dlg = 0; return true; }
                    if (k == Key.DownArrow) { root.dlg = 3; return true; }
                    return false;
                }
                entered => { root.dlg = 1; }
            }
            if root.host-edit-error != "": DialogText { text: root.host-edit-error; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                ActionButton {
                    text: "Cancel";
                    want-focus: root.dlg == 2;
                    nav(k) => {
                        if (k == Key.RightArrow) { root.dlg = 3; return true; }
                        if (k == Key.UpArrow) { root.dlg = 1; return true; }
                        return false;
                    }
                    entered => { root.dlg = 2; }
                    clicked => { root.host-edit-visible = false; }
                }
                ActionButton {
                    text: "Save host";
                    kind: 1;
                    enabled: root.host-edit-address != "";
                    want-focus: root.dlg == 3;
                    nav(k) => {
                        if (k == Key.LeftArrow) { root.dlg = 2; return true; }
                        if (k == Key.UpArrow) { root.dlg = 1; return true; }
                        return false;
                    }
                    entered => { root.dlg = 3; }
                    clicked => { root.save-host-edit(root.host-edit-name, root.host-edit-address); }
                }
            }
        }

        // Add host dialog: address (0), Cancel (1), Add (2)
        // ---------------------------------------------------------------
        if root.add-visible: Modal {
            width: 100%;
            height: 100%;
            hold-focus: root.dlg < 0;
            arrow => {
                root.dlg = 0;
            }
            dismissed => {
                if (!root.add-busy) {
                    root.add-visible = false;
                }
            }

            DialogTitle {
                text: "Add a host";
            }
            DialogText {
                text: "The IP address or name of the PC running Hermes. Add :port if it doesn't use 47989.";
            }
            TextField {
                placeholder: "192.168.0.10";
                text <=> root.add-address;
                enabled: !root.add-busy;
                auto-edit: !root.is-android;
                want-focus: root.dlg == 0;
                nav(k) => {
                    if (k == Key.DownArrow) {
                        root.dlg = 2;
                        return true;
                    }
                    return false;
                }
                entered => {
                    root.dlg = 0;
                }
                accepted(text) => {
                    root.add-host(text);
                }
            }
            if root.add-error != "": HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: start;
                    Icon {
                        width: 18px;
                        height: 18px;
                        name: "error";
                        tint: Theme.danger;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.add-error;
                    color: Theme.danger;
                    font-size: Theme.body-size;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                padding-top: 4px;
                if root.add-busy: VerticalLayout {
                    alignment: center;
                    Loader {
                        dot: 7px;
                    }
                }
                ActionButton {
                    text: "Cancel";
                    enabled: !root.add-busy;
                    want-focus: root.dlg == 1;
                    nav(k) => {
                        if (k == Key.RightArrow) {
                            root.dlg = 2;
                            return true;
                        }
                        if (k == Key.UpArrow) {
                            root.dlg = 0;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = 1;
                    }
                    clicked => {
                        root.add-visible = false;
                    }
                }
                ActionButton {
                    text: "Add host";
                    kind: 1;
                    enabled: !root.add-busy && root.add-address != "";
                    want-focus: root.dlg == 2;
                    nav(k) => {
                        if (k == Key.LeftArrow) {
                            root.dlg = 1;
                            return true;
                        }
                        if (k == Key.UpArrow) {
                            root.dlg = 0;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = 2;
                    }
                    clicked => {
                        root.add-host(root.add-address);
                    }
                }
            }
        }

        // ---------------------------------------------------------------
        // Pairing dialog. PIN: "Use a one-time code" (0), Cancel (1), Try
        // again (2). One-time code: PIN (0), passphrase (1), Cancel (2),
        // Pair (3).
        // ---------------------------------------------------------------
        if root.pair-visible: Modal {
            width: 100%;
            height: 100%;
            card-width: 460px;
            hold-focus: root.dlg < 0;
            arrow => {
                root.dlg = root.pair-otp-mode ? 0 : 1;
            }
            dismissed => { }

            DialogTitle {
                text: "Pair with " + root.pair-host-name;
            }

            if !root.pair-otp-mode: VerticalLayout {
                spacing: 14px;
                DialogText {
                    text: "Open the Hermes web UI on the host, go to PIN and enter this code:";
                }
                Rectangle {
                    height: 96px;
                    border-radius: Theme.radius;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.accent.transparentize(0.6);
                    Rectangle {
                        background: @radial-gradient(circle, Theme.accent.transparentize(0.86) 0%, Theme.accent.transparentize(1) 70%);
                        border-radius: Theme.radius;
                    }
                    Text {
                        text: root.pair-pin;
                        color: Theme.accent;
                        font-size: 50px;
                        font-weight: 700;
                        letter-spacing: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: "Use a one-time code instead";
                        icon: "link";
                        kind: 3;
                        want-focus: root.dlg == 0;
                        nav(k) => {
                            if (k == Key.DownArrow) {
                                root.dlg = 1;
                                return true;
                            }
                            return false;
                        }
                        entered => {
                            root.dlg = 0;
                        }
                        clicked => {
                            root.pair-use-otp();
                        }
                    }
                }
            }

            if root.pair-otp-mode: VerticalLayout {
                spacing: 10px;
                DialogText {
                    text: "Enter the one-time PIN and passphrase shown by Hermes.";
                }
                TextField {
                    placeholder: "PIN";
                    input-type: InputType.number;
                    text <=> root.otp-pin;
                    enabled: !root.pair-busy;
                    auto-edit: !root.is-android;
                    want-focus: root.dlg == 0;
                    nav(k) => {
                        if (k == Key.DownArrow) {
                            root.dlg = 1;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = 0;
                    }
                }
                TextField {
                    placeholder: "Passphrase";
                    text <=> root.otp-passphrase;
                    enabled: !root.pair-busy;
                    want-focus: root.dlg == 1;
                    nav(k) => {
                        if (k == Key.DownArrow) {
                            root.dlg = 3;
                            return true;
                        }
                        if (k == Key.UpArrow) {
                            root.dlg = 0;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = 1;
                    }
                    accepted(text) => {
                        if (root.otp-pin != "" && root.otp-passphrase != "" && !root.pair-busy) {
                            root.pair-submit-otp(root.otp-pin, root.otp-passphrase);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                if root.pair-busy: VerticalLayout {
                    alignment: center;
                    Loader {
                        dot: 7px;
                    }
                }
                Text {
                    text: root.pair-status;
                    color: root.pair-failed ? Theme.danger : Theme.muted;
                    font-size: Theme.body-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                ActionButton {
                    text: "Cancel";
                    want-focus: root.dlg == (root.pair-otp-mode ? 2 : 1);
                    nav(k) => {
                        if (k == Key.RightArrow && (root.pair-otp-mode || root.pair-failed)) {
                            root.dlg = root.pair-otp-mode ? 3 : 2;
                            return true;
                        }
                        if (k == Key.UpArrow) {
                            root.dlg = root.pair-otp-mode ? 1 : 0;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = root.pair-otp-mode ? 2 : 1;
                    }
                    clicked => {
                        root.pair-cancel();
                    }
                }
                if root.pair-failed && !root.pair-otp-mode: ActionButton {
                    text: "Try again";
                    icon: "refresh";
                    kind: 1;
                    want-focus: root.dlg == 2;
                    nav(k) => {
                        if (k == Key.LeftArrow) {
                            root.dlg = 1;
                            return true;
                        }
                        if (k == Key.UpArrow) {
                            root.dlg = 0;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = 2;
                    }
                    clicked => {
                        root.pair-retry();
                    }
                }
                if root.pair-otp-mode: ActionButton {
                    text: "Pair";
                    kind: 1;
                    enabled: !root.pair-busy && root.otp-pin != "" && root.otp-passphrase != "";
                    want-focus: root.dlg == 3;
                    nav(k) => {
                        if (k == Key.LeftArrow) {
                            root.dlg = 2;
                            return true;
                        }
                        if (k == Key.UpArrow) {
                            root.dlg = 1;
                            return true;
                        }
                        return false;
                    }
                    entered => {
                        root.dlg = 3;
                    }
                    clicked => {
                        root.pair-submit-otp(root.otp-pin, root.otp-passphrase);
                    }
                }
            }
        }

        // ---------------------------------------------------------------
        // Toast
        // ---------------------------------------------------------------
        // The box slides up; the card inside it never moves relative to it,
        // so its shadow texture is drawn once. The text fades in under a veil
        // of the card's colour instead of an `opacity` layer.
        if !root.stream-picture-in-picture && root.toast != "": toast-box := Rectangle {
            property <bool> shown;
            Timer {
                interval: 16ms;
                running: !toast-box.shown;
                triggered => {
                    toast-box.shown = true;
                }
            }
            x: (root.width - self.width) / 2;
            // Above the floating "Add host" button on phones.
            y: root.height - self.height - (Theme.compact && root.screen == 0 ? 100px : 28px) + (self.shown ? 0px : 24px);
            width: Math.min(toast-row.preferred-width, root.width - 32px);
            height: toast-row.preferred-height;
            animate y { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }

            Rectangle {
                border-radius: 14px;
                background: Theme.card-hover;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: #00000090;
            }
            toast-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 4px;
                        height: 18px;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
                Text {
                    max-width: root.width - 80px;
                    text: root.toast;
                    color: Theme.text;
                    font-size: Theme.body-size;
                    wrap: word-wrap;
                }
            }
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: 13px;
                background: Theme.card-hover;
                opacity: toast-box.shown ? 0 : 1;
                visible: self.opacity > 0;
                animate opacity { duration: 200ms; delay: 60ms; easing: ease-out-quad; }
            }
        }

        // ---------------------------------------------------------------
        // Startup overlay
        // ---------------------------------------------------------------
        // Fades out once the app is ready. The background and the glow are
        // plain rectangles (their opacity costs no layer); only the small
        // block in the middle fades as one.
        splash := Rectangle {
            width: 100%;
            height: 100%;
            visible: root.starting || splash-bg.opacity > 0;
            splash-bg := Rectangle {
                background: Theme.bg;
                opacity: root.starting ? 1 : 0;
                animate opacity { duration: 360ms; delay: 80ms; easing: ease-out-quad; }
            }
            TouchArea {
                enabled: root.starting;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 60px;
                width: 520px;
                height: 520px;
                background: @radial-gradient(circle, Theme.accent.transparentize(0.84) 0%, Theme.accent.transparentize(1) 65%);
                opacity: splash-bg.opacity;
            }
            splash-block := Rectangle {
                width: Math.min(parent.width - 48px, 420px);
                height: splash-content.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - (root.starting ? 0px : 16px);
                opacity: root.starting ? 1 : 0;
                animate opacity { duration: 220ms; easing: ease-out-quad; }
                animate y { duration: 360ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
                splash-content := VerticalLayout {
                    spacing: 18px;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            width: 64px;
                            height: 64px;
                            name: "flame";
                            tint: Theme.accent;
                        }
                    }
                    Text {
                        text: "Hestia";
                        color: Theme.text;
                        font-size: 40px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    // Only while starting: its timer would keep redrawing.
                    HorizontalLayout {
                        alignment: center;
                        height: 8px;
                        if root.starting: Loader {
                            dot: 8px;
                        }
                    }
                    Text {
                        text: root.starting-text;
                        color: Theme.muted;
                        font-size: Theme.body-size;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
