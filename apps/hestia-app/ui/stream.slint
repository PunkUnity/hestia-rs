import { Theme, Icon, Focusable, IconButton, Loader, Toggle } from "theme.slint";

// Small key for the keyboard bar's shortcuts.
component KeyChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: Theme.compact ? 40px : 34px;
    min-width: label.preferred-width + 26px;
    preferred-width: label.preferred-width + 26px;
    horizontal-stretch: 0;
    border-radius: 10px;
    background: touch.pressed ? Theme.accent : (touch.has-hover ? Theme.card-hover : Theme.card);
    border-width: 1px;
    border-color: touch.pressed ? Theme.accent : Theme.border;
    animate background { duration: 90ms; }
    label := Text {
        text: root.text;
        color: touch.pressed ? Theme.on-accent : Theme.text;
        font-size: Theme.caption-size + 1px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One control of the on-screen controller, laid out by the app (Rust also
// decides which finger presses what; these are only drawn).
// kind: 0 round button, 1 rectangular button, 2 stick, 3 d-pad.
export struct PadControl {
    kind: int,
    label: string,
    x: length,
    y: length,
    w: length,
    h: length,
    pressed: bool,
    knob-x: length,
    knob-y: length,
    // d-pad: held directions
    up: bool,
    down: bool,
    left: bool,
    right: bool,
}

component PadArrow inherits Rectangle {
    in property <bool> lit;
    width: 34%;
    height: 34%;
    border-radius: 6px;
    background: root.lit ? #ff7a2ea0 : #ffffff22;
    border-width: 1.5px;
    border-color: root.lit ? #ff9a57 : #ffffff90;
}

// A line of the stream menu: icon, label, and a value or an on/off pill.
component QuickRow inherits Focusable {
    in property <string> icon;
    in property <string> text;
    in property <string> value;
    // -1 no switch, 0 off, 1 on
    in property <int> state: -1;

    accessible-role: button;
    accessible-label: root.text;
    height: Theme.compact ? 52px : 46px;
    border-radius: 12px;
    background: root.pressed ? Theme.border : (root.focused || root.hovered ? Theme.card-hover : Theme.surface.transparentize(1));
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.accent;
    drop-shadow-blur: 14px;
    drop-shadow-color: root.focused ? Theme.glow : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: root.state == 1 ? Theme.accent : Theme.muted;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: Theme.body-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.value != "": Text {
            text: root.value;
            color: root.focused ? Theme.accent : Theme.muted;
            font-size: Theme.caption-size + 1px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.state >= 0: VerticalLayout {
            alignment: center;
            Toggle {
                on: root.state == 1;
            }
        }
    }
}

// The two big actions at the top of the stream menu.
component QuickTile inherits Focusable {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger;

    accessible-role: button;
    accessible-label: root.text;
    height: Theme.compact ? 76px : 70px;
    border-radius: 14px;
    background: root.danger
        ? (root.pressed || root.focused || root.hovered ? Theme.danger.transparentize(0.72) : Theme.danger.transparentize(0.86))
        : (root.pressed ? Theme.border : (root.focused || root.hovered ? Theme.card-hover : Theme.card));
    border-width: root.focused ? 2px : 0px;
    border-color: root.danger ? Theme.danger : Theme.accent;
    drop-shadow-blur: 16px;
    drop-shadow-color: !root.focused ? transparent : (root.danger ? Theme.danger.transparentize(0.5) : Theme.glow);
    transform-scale: root.pressed ? 0.95 : 1;
    animate background { duration: 100ms; }
    animate transform-scale { duration: 110ms; easing: ease-out-quad; }

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding: 8px;
        HorizontalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: root.danger ? Theme.danger : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.caption-size + 1px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Full-window video with input capture. Keyboard, mouse and touch go to the
// host; Ctrl+Alt+Shift+Q disconnects, Ctrl+Alt+Shift+S toggles statistics,
// Ctrl+Alt+Shift+Z captures the mouse (desktop). Touch acts as a trackpad
// (relative cursor, tap = click, hold = right click, tap-then-drag = drag)
// unless direct mode is chosen. Physical keys and every finger are also read
// below Slint by the app (keys by position, fingers each with its own id);
// the view tells it when it has the input.
export component StreamView inherits Rectangle {
    in property <image> frame;
    in property <bool> picture-in-picture: false;
    // The picture is on the direct video surface behind the window.
    in property <bool> direct-video: false;
    in property <string> stats;
    // Shown over the video while there is no picture yet.
    in property <string> status;
    // What's streaming, for the menu's header: the app and the host.
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-stats: true;
    in property <bool> fullscreen;
    in property <bool> window-fullscreen;
    in property <bool> touch-controls;
    // 0 trackpad, 1 mouse, 2 touchscreen
    in property <int> touch-mode: 0;
    callback cycle-touch-mode();
    // On-screen controller.
    in property <bool> pad-visible: false;
    // Hermes host with clipboard support: one-off send / fetch in the menu.
    in property <bool> clipboard-actions: false;
    callback clipboard-send();
    callback clipboard-fetch();
    in property <[PadControl]> pad-controls;
    callback toggle-pad();
    // The view's size, for the controller's layout.
    callback view-size(float, float);
    // Pinch-to-zoom and pan (two fingers) while zoom mode is on.
    in property <bool> zoom-mode: false;
    in property <float> zoom: 1;
    in property <float> pan-x: 0;
    in property <float> pan-y: 0;
    callback toggle-zoom();
    // 0 fit, 1 fill (crop), 2 stretch.
    in property <int> video-scale: 0;
    callback cycle-scale();
    // The on-screen keyboard (Android) is up; the shortcut row shows.
    in-out property <bool> keyboard-open: false;
    // Always show the menu button (otherwise Back / Escape open the menu).
    in property <bool> show-menu-button: true;
    // Whether "Keyboard" opens an on-screen keyboard (phones).
    in property <bool> soft-keyboard: false;
    // Short-lived note at the bottom (e.g. how Hermes serves the stream).
    in property <string> banner;
    // Mouse capture (desktop): the host gets relative motion, for games.
    in property <bool> mouse-capture-available: false;
    in property <bool> mouse-capture: false;
    callback toggle-mouse-capture();
    // The view has the keyboard and mouse: its window is focused and the
    // menu is closed. Losing them lets go of whatever the host holds.
    callback input-focus(bool);

    // text, pressed, repeat, ctrl, alt, shift, meta
    callback key-event(string, bool, bool, bool, bool, bool, bool);
    // kind (0 down, 1 up, 2 move, 3 cancel), button (1 left, 2 middle,
    // 3 right, 4 back, 5 forward), x, y relative to the video, video width,
    // height, finger id (0 = mouse), x, y relative to the view
    callback pointer(int, int, float, float, float, float, int, float, float);
    callback scrolled(float, float);
    callback special-key(string);
    callback toggle-stats();
    callback toggle-fullscreen();
    callback request-keyframe();
    callback disconnect();
    callback quit-app();

    in-out property <bool> menu-open: false;
    property <float> frame-w: root.frame.width > 0 ? root.frame.width : 16;
    property <float> frame-h: root.frame.height > 0 ? root.frame.height : 9;
    property <float> picture-zoom: root.picture-in-picture ? 1 : root.zoom;
    property <bool> stretch-picture: !root.picture-in-picture && root.video-scale == 2;
    property <float> scale: !root.picture-in-picture && root.video-scale == 1
        ? max(root.width / 1px / root.frame-w, root.height / 1px / root.frame-h)
        : min(root.width / 1px / root.frame-w, root.height / 1px / root.frame-h);
    property <[{id: string, label: string}]> keys: [
        { id: "esc", label: "Esc" },
        { id: "tab", label: "Tab" },
        { id: "enter", label: "Enter" },
        { id: "backspace", label: "⌫" },
        { id: "win", label: "Win" },
        { id: "alt-tab", label: "Alt+Tab" },
        { id: "alt-f4", label: "Alt+F4" },
    ];

    background: root.direct-video ? transparent : black;
    // Fill mode makes the picture larger than the view.
    clip: true;

    init => {
        root.view-size(self.width / 1px, self.height / 1px);
    }
    changed width => {
        root.view-size(self.width / 1px, self.height / 1px);
    }
    changed height => {
        root.view-size(self.width / 1px, self.height / 1px);
    }

    changed keyboard-open => {
        if (!root.keyboard-open) {
            focus.focus();
        }
    }

    // TV remote / keyboard in the menu: the focused entry, -1 until an
    // arrow key is pressed. Hidden rows consume no position.
    property <int> menu-focus: -1;
    property <int> touch-row: root.clipboard-actions ? 6 : 4;
    property <int> mouse-row: root.touch-row + (root.touch-controls ? 1 : 0);
    property <int> pad-row: root.mouse-row + (root.mouse-capture-available ? 1 : 0);
    property <int> zoom-row: root.pad-row + 1;
    property <int> picture-row: root.pad-row + (root.touch-controls ? 2 : 0);
    property <int> stats-row: root.picture-row + 1;
    property <int> keyframe-row: root.stats-row + 1;
    property <int> fullscreen-row: root.keyframe-row + 1;
    // Quit asks for a second press.
    property <bool> quit-armed;
    changed menu-open => {
        root.quit-armed = false;
        if (!root.menu-open) {
            root.menu-focus = -1;
            focus.focus();
        }
        root.input-focus(!root.picture-in-picture && !root.menu-open && focus.has-focus);
    }
    changed picture-in-picture => {
        root.input-focus(!root.picture-in-picture && !root.menu-open && focus.has-focus);
    }
    function menu-move(from: int, key: string) -> bool {
        if (key == Key.Back || key == Key.Escape) {
            root.menu-open = false;
            return true;
        }
        if (from == 0) {
            if (key == Key.DownArrow) {
                root.menu-focus = 1;
                return true;
            }
            return false;
        }
        if (from == 1 || from == 2) {
            if (key == Key.RightArrow && from == 1) {
                root.menu-focus = 2;
            } else if (key == Key.LeftArrow && from == 2) {
                root.menu-focus = 1;
            } else if (key == Key.UpArrow) {
                root.menu-focus = 0;
            } else if (key == Key.DownArrow) {
                root.menu-focus = 3;
            } else {
                return false;
            }
            return true;
        }
        if (key == Key.DownArrow) {
            root.menu-focus = min(from + 1, root.window-fullscreen ? root.fullscreen-row : root.keyframe-row);
            return true;
        }
        if (key == Key.UpArrow) {
            root.menu-focus = from == 3 ? 1 : from - 1;
            return true;
        }
        return false;
    }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        init => {
            self.focus();
        }
        // Window focus comes and goes, the menu's entries take the focus.
        focus-gained => {
            root.input-focus(!root.picture-in-picture && !root.menu-open);
        }
        focus-lost => {
            root.input-focus(false);
        }
        key-pressed(event) => {
            if (root.picture-in-picture) {
                return accept;
            }
            // Android back: close the keyboard bar, else toggle the menu.
            if (event.text == Key.Back) {
                if (root.keyboard-open) {
                    root.keyboard-open = false;
                } else {
                    root.menu-open = !root.menu-open;
                }
                return accept;
            }
            // Menu open: the first arrow key focuses Disconnect.
            if (root.menu-open && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                root.menu-focus = 1;
                return accept;
            }
            root.key-event(event.text, true, event.repeat, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }
        key-released(event) => {
            if (root.picture-in-picture || event.text == Key.Back) {
                return accept;
            }
            root.key-event(event.text, false, false, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            accept
        }

        video := Rectangle {
            width: (root.stretch-picture ? parent.width : root.frame-w * root.scale * 1px) * root.picture-zoom;
            height: (root.stretch-picture ? parent.height : root.frame-h * root.scale * 1px) * root.picture-zoom;
            x: (parent.width - self.width) / 2 + (root.picture-in-picture ? 0 : root.pan-x * 1px);
            // Portrait with the on-screen controller: the picture goes to
            // the top, the controller under it (same ratio as the layout).
            y: (!root.picture-in-picture && root.pad-visible && parent.height >= parent.width * 1.3
                ? (self.height / root.picture-zoom - self.height) / 2
                : (parent.height - self.height) / 2) + (root.picture-in-picture ? 0 : root.pan-y * 1px);

            Image {
                width: 100%;
                height: 100%;
                source: root.frame;
                image-fit: fill;
            }
        }

        // The whole view takes input: in trackpad mode the black bars are
        // part of the pad, and absolute positions are clamped to the video.
        TouchArea {
            enabled: !root.picture-in-picture;
            mouse-cursor: none;
            pointer-event(event) => {
                root.pointer(
                    event.kind == PointerEventKind.down ? 0
                        : event.kind == PointerEventKind.up ? 1
                        : event.kind == PointerEventKind.move ? 2 : 3,
                    event.button == PointerEventButton.left ? 1
                        : event.button == PointerEventButton.middle ? 2
                        : event.button == PointerEventButton.right ? 3
                        : event.button == PointerEventButton.back ? 4
                        : event.button == PointerEventButton.forward ? 5 : 0,
                    (self.mouse-x - video.x) / 1px,
                    (self.mouse-y - video.y) / 1px,
                    video.width / 1px,
                    video.height / 1px,
                    event.touch-finger-id,
                    self.mouse-x / 1px,
                    self.mouse-y / 1px);
            }
            scroll-event(event) => {
                root.scrolled(event.delta-x / 1px, event.delta-y / 1px);
                accept
            }
        }
    }

    // On-screen controller (drawn only; touches reach the area above).
    if !root.picture-in-picture && root.pad-visible: Rectangle {
        width: 100%;
        height: 100%;
        for c in root.pad-controls: Rectangle {
            x: c.x - c.w / 2;
            y: c.y - c.h / 2;
            width: c.w;
            height: c.h;

            if c.kind == 0 || c.kind == 1: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: c.kind == 0 ? self.height / 2 : 10px;
                background: c.pressed ? #ff7a2e90 : #ffffff22;
                border-width: 1.5px;
                border-color: c.pressed ? #ff9a57 : #ffffff90;
                Text {
                    width: 100%;
                    height: 100%;
                    text: c.label;
                    color: white;
                    font-size: min(c.h * 0.42, 20px);
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if c.kind == 2: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: self.width / 2;
                background: #ffffff16;
                border-width: 1.5px;
                border-color: #ffffff70;
                Rectangle {
                    width: parent.width * 0.46;
                    height: self.width;
                    x: (parent.width - self.width) / 2 + c.knob-x;
                    y: (parent.height - self.height) / 2 + c.knob-y;
                    border-radius: self.width / 2;
                    background: c.pressed ? #ff7a2ec0 : #ffffff50;
                }
            }
            if c.kind == 3: Rectangle {
                width: 100%;
                height: 100%;
                PadArrow {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    lit: c.up;
                }
                PadArrow {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height;
                    lit: c.down;
                }
                PadArrow {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    lit: c.left;
                }
                PadArrow {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    lit: c.right;
                }
            }
        }
    }

    // No picture yet: what's happening, over a soft ember glow.
    if root.status != "": Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, #ff7a2e1c 0%, #ff7a2e00 60%);
        VerticalLayout {
            alignment: center;
            spacing: 18px;
            padding: 24px;
            if root.title != "": Text {
                text: root.title;
                color: #f5eee8;
                font-size: Theme.display-size;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                alignment: center;
                Loader {
                    dot: 10px;
                    tint: #ff7a2e;
                }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: Math.min(root.width - 48px, 520px);
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: root.status;
                    color: #ab9f95;
                    font-size: Theme.body-size + 1px;
                }
            }
        }
    }

    if !root.picture-in-picture && root.show-stats && root.stats != "" && !root.keyboard-open: Rectangle {
        x: 12px;
        // Under the menu button when the controller puts it in the middle.
        y: root.pad-visible && root.show-menu-button ? Theme.control-height + 20px : 12px;
        // Wraps on narrow screens instead of running under the menu button.
        property <length> max-w: root.width - 84px;
        width: Theme.compact ? self.max-w : Math.min(stats-text.preferred-width + 24px, self.max-w);
        height: stats-text.preferred-height + 14px;
        border-radius: 12px;
        background: #0a0807b8;
        border-width: 1px;
        border-color: #ffffff12;
        stats-text := Text {
            x: 12px;
            y: 7px;
            width: parent.width - 24px;
            text: root.stats;
            color: #f0e9e3;
            font-size: 12px;
            font-weight: 500;
            wrap: word-wrap;
        }
    }

    // Rises from below the edge. Over the video everything redraws with
    // each picture, so overlays here only move: an `opacity` fade would be
    // an offscreen layer on every frame, a shadow one more texture to draw.
    if !root.picture-in-picture && root.banner != "" && !root.keyboard-open: banner-box := Rectangle {
        property <bool> shown;
        Timer {
            interval: 16ms;
            running: !banner-box.shown;
            triggered => {
                banner-box.shown = true;
            }
        }
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px + (self.shown ? 0px : self.height + 48px);
        animate y { duration: 420ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
        width: Math.min(banner-row.preferred-width, root.width - 32px);
        height: banner-row.preferred-height;
        border-radius: 14px;
        background: #0a0807d0;
        border-width: 1px;
        border-color: Theme.accent.transparentize(0.6);
        banner-row := HorizontalLayout {
            padding-left: 14px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                Icon {
                    width: 18px;
                    height: 18px;
                    name: "flame";
                    tint: Theme.accent;
                }
            }
            Text {
                max-width: root.width - 90px;
                text: root.banner;
                color: #f0e9e3;
                font-size: Theme.caption-size + 1px;
                wrap: word-wrap;
            }
        }
    }

    // Shortcut keys while the keyboard is open: a slim row at the top, so
    // the on-screen keyboard (which types straight into the host) can't
    // cover it.
    if !root.picture-in-picture && root.keyboard-open: key-box := Rectangle {
        property <bool> shown;
        Timer {
            interval: 16ms;
            running: !key-box.shown;
            triggered => {
                key-box.shown = true;
            }
        }
        x: 8px;
        y: self.shown ? 8px : -self.height - 8px;
        animate y { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        width: root.width - (root.show-menu-button ? Theme.control-height + 28px : 16px);
        height: key-bar.preferred-height;
        border-radius: 16px;
        background: Theme.surface.transparentize(0.06);
        border-width: 1px;
        border-color: Theme.border;

        key-bar := HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Flickable {
                height: Theme.compact ? 40px : 34px;
                content-height: self.height;
                content-width: key-row.preferred-width;
                key-row := HorizontalLayout {
                    width: self.preferred-width;
                    height: parent.height;
                    spacing: 6px;
                    for key in root.keys: KeyChip {
                        text: key.label;
                        clicked => {
                            root.special-key(key.id);
                        }
                    }
                }
            }
            IconButton {
                icon: "close";
                label: root.soft-keyboard ? "Hide the keyboard" : "Hide shortcut keys";
                clicked => {
                    root.keyboard-open = false;
                }
            }
        }
    }

    // Menu handle, top right: only when asked for in Settings (Back or
    // Escape open the menu otherwise). With the on-screen controller it
    // moves to the top centre, off the triggers.
    if !root.picture-in-picture && root.show-menu-button && !root.menu-open: Rectangle {
        x: root.pad-visible && !root.keyboard-open ? (parent.width - self.width) / 2 : parent.width - self.width - 12px;
        y: 12px;
        width: Theme.control-height;
        height: Theme.control-height;
        border-radius: self.height / 2;
        background: handle.has-hover || handle.pressed ? Theme.accent.transparentize(0.3) : #0a0807a0;
        border-width: 1px;
        border-color: #ffffff1c;
        transform-scale: handle.pressed ? 0.9 : 1;
        animate background { duration: 120ms; }
        animate transform-scale { duration: 110ms; easing: ease-out-quad; }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "menu";
            tint: white;
        }
        // On press, not click: nothing under the finger can swallow it.
        handle := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.menu-open = true;
                }
            }
        }
    }

    // The menu: a drawer that slides in from the right over a dimmed picture
    // and back out when it closes; tapping the picture closes it. Both stay
    // in the tree for the slide out, hidden (not drawn, no input) once the
    // drawer is off screen. No shadow and no fade: they would cost on every
    // video frame, and the dimming already sets the drawer apart.
    Rectangle {
        visible: !root.picture-in-picture && (root.menu-open || panel.x < root.width);
        background: root.menu-open ? #0000007a : #00000000;
        animate background { duration: 240ms; easing: ease-out-quad; }
        TouchArea {
            enabled: root.menu-open;
            clicked => {
                root.menu-open = false;
            }
        }
    }
    panel := Rectangle {
        width: Math.min(Theme.compact ? 340px : 360px, root.width - 20px);
        height: root.height - 20px;
        x: root.menu-open ? root.width - self.width - 10px : root.width + 2px;
        y: 10px;
        visible: !root.picture-in-picture && (root.menu-open || self.x < root.width);
        animate x { duration: 320ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        border-radius: Theme.radius + 2px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        // Swallow taps so they don't reach the picture.
        TouchArea { }

        Flickable {
            content-width: self.width;
            content-height: menu-list.preferred-height;
            menu-list := VerticalLayout {
                width: panel.width;
                padding: 10px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.title == "" ? "Stream" : root.title;
                            color: Theme.text;
                            font-size: Theme.title-size;
                            font-weight: 700;
                            overflow: elide;
                        }
                        if root.subtitle != "": Text {
                            text: root.subtitle;
                            color: Theme.muted;
                            font-size: Theme.caption-size;
                            overflow: elide;
                        }
                    }
                    IconButton {
                        icon: "close";
                        label: "Close the menu";
                        want-focus: root.menu-focus == 0;
                        nav(key) => {
                            return root.menu-move(0, key);
                        }
                        entered => {
                            root.menu-focus = 0;
                        }
                        clicked => {
                            root.menu-open = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    padding-bottom: 8px;
                    QuickTile {
                        icon: "logout";
                        text: "Disconnect";
                        want-focus: root.menu-focus == 1;
                        nav(key) => {
                            return root.menu-move(1, key);
                        }
                        entered => {
                            root.menu-focus = 1;
                        }
                        clicked => {
                            root.menu-open = false;
                            root.disconnect();
                        }
                    }
                    QuickTile {
                        icon: "power";
                        text: root.quit-armed ? "Press again to quit" : "Quit app";
                        danger: true;
                        want-focus: root.menu-focus == 2;
                        nav(key) => {
                            return root.menu-move(2, key);
                        }
                        entered => {
                            root.menu-focus = 2;
                        }
                        clicked => {
                            if (root.quit-armed) {
                                root.menu-open = false;
                                root.quit-app();
                            } else {
                                root.quit-armed = true;
                            }
                        }
                    }
                }

                QuickRow {
                    icon: "keyboard";
                    text: root.keyboard-open ? (root.soft-keyboard ? "Hide keyboard" : "Hide shortcut keys") : (root.soft-keyboard ? "Keyboard" : "Shortcut keys");
                    value: root.touch-controls && root.soft-keyboard && !root.keyboard-open ? "3-finger tap" : "";
                    want-focus: root.menu-focus == 3;
                    nav(key) => {
                        return root.menu-move(3, key);
                    }
                    entered => {
                        root.menu-focus = 3;
                    }
                    clicked => {
                        root.keyboard-open = !root.keyboard-open;
                        root.menu-open = false;
                    }
                }
                if root.clipboard-actions: QuickRow {
                    icon: "upload";
                    text: "Send clipboard to host";
                    want-focus: root.menu-focus == 4;
                    nav(key) => {
                        return root.menu-move(4, key);
                    }
                    entered => {
                        root.menu-focus = 4;
                    }
                    clicked => {
                        root.clipboard-send();
                        root.menu-open = false;
                    }
                }
                if root.clipboard-actions: QuickRow {
                    icon: "download";
                    text: "Get host's clipboard";
                    want-focus: root.menu-focus == 5;
                    nav(key) => {
                        return root.menu-move(5, key);
                    }
                    entered => {
                        root.menu-focus = 5;
                    }
                    clicked => {
                        root.clipboard-fetch();
                        root.menu-open = false;
                    }
                }
                if root.touch-controls: QuickRow {
                    icon: "mouse";
                    text: "Touch";
                    value: root.touch-mode == 0 ? "Trackpad" : (root.touch-mode == 1 ? "Mouse" : "Touchscreen");
                    want-focus: root.menu-focus == root.touch-row;
                    nav(key) => {
                        return root.menu-move(root.touch-row, key);
                    }
                    entered => {
                        root.menu-focus = root.touch-row;
                    }
                    clicked => {
                        root.cycle-touch-mode();
                    }
                }
                if root.mouse-capture-available: QuickRow {
                    icon: "mouse";
                    text: "Capture mouse";
                    value: "Ctrl+Alt+Shift+Z";
                    state: root.mouse-capture ? 1 : 0;
                    want-focus: root.menu-focus == root.mouse-row;
                    nav(key) => {
                        return root.menu-move(root.mouse-row, key);
                    }
                    entered => {
                        root.menu-focus = root.mouse-row;
                    }
                    clicked => {
                        root.toggle-mouse-capture();
                        root.menu-open = false;
                    }
                }
                if root.touch-controls: QuickRow {
                    icon: "gamepad";
                    text: "On-screen controller";
                    state: root.pad-visible ? 1 : 0;
                    want-focus: root.menu-focus == root.pad-row;
                    nav(key) => {
                        return root.menu-move(root.pad-row, key);
                    }
                    entered => {
                        root.menu-focus = root.pad-row;
                    }
                    clicked => {
                        root.toggle-pad();
                        root.menu-open = false;
                    }
                }
                if root.touch-controls: QuickRow {
                    icon: "zoom";
                    text: root.zoom-mode ? "Zoom (pinch, pan with 2 fingers)" : "Zoom";
                    state: root.zoom-mode ? 1 : 0;
                    want-focus: root.menu-focus == root.zoom-row;
                    nav(key) => {
                        return root.menu-move(root.zoom-row, key);
                    }
                    entered => {
                        root.menu-focus = root.zoom-row;
                    }
                    clicked => {
                        root.toggle-zoom();
                        root.menu-open = false;
                    }
                }
                QuickRow {
                    icon: "aspect";
                    text: "Picture";
                    value: root.video-scale == 0 ? "Fit" : (root.video-scale == 1 ? "Fill" : "Stretch");
                    want-focus: root.menu-focus == root.picture-row;
                    nav(key) => {
                        return root.menu-move(root.picture-row, key);
                    }
                    entered => {
                        root.menu-focus = root.picture-row;
                    }
                    clicked => {
                        root.cycle-scale();
                    }
                }
                QuickRow {
                    icon: "stats";
                    text: "Statistics";
                    state: root.show-stats ? 1 : 0;
                    want-focus: root.menu-focus == root.stats-row;
                    nav(key) => {
                        return root.menu-move(root.stats-row, key);
                    }
                    entered => {
                        root.menu-focus = root.stats-row;
                    }
                    clicked => {
                        root.toggle-stats();
                    }
                }
                QuickRow {
                    icon: "refresh";
                    text: "Fix picture";
                    value: "New keyframe";
                    want-focus: root.menu-focus == root.keyframe-row;
                    nav(key) => {
                        return root.menu-move(root.keyframe-row, key);
                    }
                    entered => {
                        root.menu-focus = root.keyframe-row;
                    }
                    clicked => {
                        root.request-keyframe();
                        root.menu-open = false;
                    }
                }
                if root.window-fullscreen: QuickRow {
                    icon: root.fullscreen ? "fullscreen-exit" : "fullscreen";
                    text: "Full screen";
                    state: root.fullscreen ? 1 : 0;
                    want-focus: root.menu-focus == root.fullscreen-row;
                    nav(key) => {
                        return root.menu-move(root.fullscreen-row, key);
                    }
                    entered => {
                        root.menu-focus = root.fullscreen-row;
                    }
                    clicked => {
                        root.toggle-fullscreen();
                        root.menu-open = false;
                    }
                }
                if !Theme.compact && root.mouse-capture-available: Text {
                    text: "Ctrl+Alt+Shift+Q disconnects, Ctrl+Alt+Shift+S shows statistics, Ctrl+Alt+Shift+Z captures the mouse";
                    color: Theme.faint;
                    font-size: Theme.caption-size;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
