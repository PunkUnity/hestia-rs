<?xml version="1.0" encoding="utf-8"?>
<!--
  Hestia RS's manifest, packaged by scripts/android-package.sh (aapt2): a
  NativeActivity running libhestia_app.so, on phones, tablets, Chromebooks
  and Android TV (leanback launcher, banner, no touchscreen required).
  Version code/name and SDK levels come from the packaging script.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mroz59.hestia.rs">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wi-Fi locks that keep the radio out of power save during a stream. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Whether Bluetooth is on, for the session report (Android 12+ needs
         no permission for that; nothing asks for nearby devices). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Controller rumble on the phone when the controller has no motor. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Nothing here is required, so TVs, boxes and Chromebooks qualify. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application
        android:label="Hestia RS"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:extractNativeLibs="true"
        android:appCategory="game">

        <!-- Rotation, keyboards and display changes must not recreate the
             activity (that would restart the native app mid-stream). -->
        <activity
            android:name=".HestiaActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|touchscreen">
            <meta-data android:name="android.app.lib_name" android:value="hestia_app" />
        </activity>
        <!-- Keep the launcher component from earlier APKs. NativeActivity
             reads the native library name from the intent's component. -->
        <activity-alias
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:targetActivity=".HestiaActivity">
            <meta-data android:name="android.app.lib_name" android:value="hestia_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
